# 数据目录（Docker 里用 /data）
DATA_DIR=./data

# 采集间隔（秒）。默认 15 分钟扫一轮。
COLLECT_INTERVAL_SECONDS=900

# 每轮最多用大模型精加工的条目数（省费用）
ENRICH_TOP_N=12

# OpenAI 兼容接口。不填也能采集、打分、出简报；填了才会写「深度介绍 / 全过程」。
# 国内可用 DeepSeek / 硅基流动 / 智谱 等兼容接口，改 BASE_URL 和 MODEL 即可。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# GitHub 提高限额（不填也能跑，但每小时约 60 次）
GITHUB_TOKEN=

# 远程试跑：点「发给远程跑」时 POST 到这个地址。不填则只生成任务包，不外发。
DISPATCH_WEBHOOK_URL=
DISPATCH_TOKEN=

# Web
HOST=0.0.0.0
PORT=8080
# 单进程同时跑采集（docker run 一个容器时用 1）
EMBED_WORKER=0
