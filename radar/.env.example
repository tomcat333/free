# 数据目录（Docker 里用 /data）
DATA_DIR=./data

# 采集间隔（秒）。默认 15 分钟扫一轮。
COLLECT_INTERVAL_SECONDS=900

# 每轮采集后，自动用大模型精加工的条数。
# 默认 0 = 不自动总结，只有你在网页上点「生成深度介绍 / 全过程」才调用（省 token）。
# 若想每轮自动写前 N 条高分条目的介绍，可改成 5、12 等。
ENRICH_TOP_N=0

# OpenAI 兼容接口。变量名叫 OPENAI_*，但不必用 OpenAI 官方。
# 国内可用 DeepSeek / 硅基流动 / 智谱等，改 BASE_URL 和 MODEL 即可。
# 不填也能采集、打分、出列表；填了之后点按钮才会写「深度介绍 / 全过程」。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# 示例：本地 Ollama（不消耗云端 API token）
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://127.0.0.1:11434/v1
# OPENAI_MODEL=qwen2.5:7b

# 示例（任选其一，取消注释并填自己的 key）：
# DeepSeek:
# OPENAI_API_KEY=sk-xxx
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_MODEL=deepseek-chat
#
# 硅基流动:
# OPENAI_API_KEY=sk-xxx
# OPENAI_BASE_URL=https://api.siliconflow.cn/v1
# OPENAI_MODEL=deepseek-ai/DeepSeek-V3

# GitHub 提高限额（不填也能跑，但每小时约 60 次）
GITHUB_TOKEN=

# 远程试跑：点「发给远程跑」时 POST 到这个地址。不填则只生成任务包，不外发。
DISPATCH_WEBHOOK_URL=
DISPATCH_TOKEN=

# Web
HOST=0.0.0.0
PORT=8787
# 单进程同时跑采集（docker run 一个容器时用 1）
EMBED_WORKER=0
